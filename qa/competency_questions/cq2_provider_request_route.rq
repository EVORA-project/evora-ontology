# Catalogue task: Who provides the resource and how can it be requested?
PREFIX EVORAO: <https://w3id.org/evorao/>
PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>

SELECT ?resource ?providerName ?accessPoint ?endpoint
WHERE {
  ?resource EVORAO:provider ?provider ;
            EVORAO:accessPointUrl ?accessPoint .
  ?provider foaf:name ?providerName .
  OPTIONAL {
    ?service dcat:servesDataset ?resource ;
             dcat:endpointURL ?endpoint .
  }
}
ORDER BY ?resource
