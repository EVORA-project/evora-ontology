# Catalogue task: Which safety and transport information accompanies the resource?
PREFIX EVORAO: <https://w3id.org/evorao/>
PREFIX dct: <http://purl.org/dc/terms/>

SELECT ?resource ?biosafetyLevel ?biosafetyRestrictions
WHERE {
  ?resource EVORAO:biosafetyLevel ?level ;
            EVORAO:biosafetyRestrictions ?biosafetyRestrictions .
  ?level dct:title ?biosafetyLevel .
}
ORDER BY ?resource
