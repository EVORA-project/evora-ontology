# Catalogue task: Which products or services are associated with a pathogen or taxonomic entity?
PREFIX EVORAO: <https://w3id.org/evorao/>
PREFIX dct: <http://purl.org/dc/terms/>

SELECT ?resource ?resourceTitle ?pathogenName ?taxon
WHERE {
  ?resource EVORAO:pathogenIdentification ?identification ;
            dct:title ?resourceTitle .
  OPTIONAL {
    ?identification EVORAO:pathogenName ?pathogenNode .
    ?pathogenNode dct:title ?pathogenName .
  }
  OPTIONAL { ?identification EVORAO:taxon ?taxon . }
}
ORDER BY ?resource
